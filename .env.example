# ---------------------------------------------------------------
# market-tracker environment variables
#
# 1. Copy this file to .env.local   (cp .env.example .env.local)
# 2. Fill in real values in .env.local ONLY.
# 3. Never put real keys in this file - it is committed to git.
#
# All of these are read server-side only. None are prefixed with
# NEXT_PUBLIC_, so they are never sent to the browser.
# The app works with every value left blank: missing data sources
# fall back to a clearly labelled sample-data mode.
# ---------------------------------------------------------------

# Which provider supplies market prices.
#   yahoo      - default. No key needed. Unofficial endpoint, personal use only.
#   twelvedata - official free tier (800 credits/day). Needs TWELVE_DATA_API_KEY.
#                Free plan is mostly US-only, so UK/EU/Asia indices fall back to sample.
#   sample     - never calls the network. Clearly labelled demo data.
MARKET_DATA_PROVIDER=yahoo

# https://twelvedata.com/ -> sign up -> API keys
TWELVE_DATA_API_KEY=your_twelve_data_api_key_here

# https://fred.stlouisfed.org/docs/api/api_key.html (free, used in Phase 2)
FRED_API_KEY=your_fred_api_key_here
